# Copy this file to .env and fill in the values from your Algolia dashboard.
# Use a dedicated parent key with the Search ACL only. Never use an Admin API key.
ALGOLIA_APP_ID=YOUR_ALGOLIA_APPLICATION_ID
ALGOLIA_PARENT_SEARCH_API_KEY=YOUR_SERVER_ONLY_SEARCH_API_KEY

# Comma-separated indexes the browser will be able to search.
ALGOLIA_INDEX_NAMES=dev_programs,dev_programs_query_suggestions

# Secured browser keys expire after this many seconds (1 hour by default).
ALGOLIA_SECURED_KEY_TTL_SECONDS=3600
